# Function secrets: set with `supabase secrets set KEY=VALUE`.
# Must equal settleup.app_config 'push_webhook_secret'.
PUSH_WEBHOOK_SECRET=
# Optional: Expo access token with push permission (expo.dev > Access tokens).
EXPO_ACCESS_TOKEN=
# SUPABASE_URL and SUPABASE_ANON_KEY are provided by the platform.
# Never set SUPABASE_SERVICE_ROLE_KEY for this function.
