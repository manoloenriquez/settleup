# Expo/React Native + CocoaPods tooling assumes an npm-style (flat, nested-on-
# conflict) node_modules. pnpm's default isolated linker hoists a single version
# of each package, which broke `expo run:ios` (hosted-git-info@7 resolved the
# hoisted lru-cache@5 instead of its required v10 -> "LRUCache is not a constructor").
# node-linker=hoisted nests each package's correct version, fixing native builds.
node-linker=hoisted
strict-peer-dependencies=false
auto-install-peers=true

# Hoist OpenTelemetry packages so Turbopack can resolve them from @sentry/nextjs.
# Without this, `next dev --turbopack` fails with:
#   Module not found: Can't resolve '@opentelemetry/semantic-conventions'
# (pnpm's strict node_modules hides Sentry's transitive otel deps from Turbopack's resolver).
public-hoist-pattern[]=*@opentelemetry/*
