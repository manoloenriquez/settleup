shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true

# Hoist OpenTelemetry packages so Turbopack can resolve them from @sentry/nextjs.
# Without this, `next dev --turbopack` fails with:
#   Module not found: Can't resolve '@opentelemetry/semantic-conventions'
# (pnpm's strict node_modules hides Sentry's transitive otel deps from Turbopack's resolver).
public-hoist-pattern[]=*@opentelemetry/*
