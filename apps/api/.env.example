PORT=4000
NODE_ENV=development

# LLM
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
LLM_ENABLED=true

# Supabase (JWT verification + rate-limit RPC)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...

# Service role — used ONLY for privileged admin actions (e.g. /account DELETE).
# Never expose to clients. Must not be present in apps/web or apps/mobile builds.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# CORS — comma-separated origins (Expo Go exp:// URLs are allowed automatically)
ALLOWED_ORIGINS=http://localhost:3000,https://settleup.app
