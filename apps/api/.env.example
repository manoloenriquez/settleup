PORT=4000
NODE_ENV=development

# Supabase (JWT verification + rate-limit RPC)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...

# No service-role key: account closure runs `settleup.close_account()` with the
# caller's own JWT. Do not add SUPABASE_SERVICE_ROLE_KEY to this service.

# CORS — comma-separated browser origins. Expo Go exp:// URLs are reflected in
# development only. In production list the owned web origin, e.g.
# ALLOWED_ORIGINS=https://app.your-owned-domain.example
ALLOWED_ORIGINS=http://localhost:3000

# Error reporting — Sentry. Leave unset for no-op.
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
# SENTRY_ENV=production
