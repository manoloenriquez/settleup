# Supabase — all Expo public vars must be prefixed EXPO_PUBLIC_
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App
EXPO_PUBLIC_APP_NAME=Tabkind

# Web app URL (for share links)
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# API — standalone Hono server (apps/api), used for account closure only.
# Root URL (no trailing slash). All AI features run on-device (Apple
# Intelligence, iOS 27+) and never call this server.
# Dev: use your Mac's LAN IP so physical devices can reach it
# EXPO_PUBLIC_API_URL=http://<mac-ip>:4000
# Prod: EXPO_PUBLIC_API_URL=https://<your-owned-api-domain>

# Error reporting — Sentry. Leave unset for no-op (no init, no requests).
# EXPO_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
# EXPO_PUBLIC_SENTRY_ENV=production

# Required for production EAS builds and verified invitation links.
EXPO_PUBLIC_SUPPORT_EMAIL=
EAS_PROJECT_ID=
IOS_BUNDLE_IDENTIFIER=
ANDROID_PACKAGE=
