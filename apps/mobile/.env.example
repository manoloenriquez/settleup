# Supabase — all Expo public vars must be prefixed EXPO_PUBLIC_
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App
EXPO_PUBLIC_APP_NAME=SettleUp

# Web app URL (for share links)
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# AI API (points to the web app's API routes for receipt scanning)
# EXPO_PUBLIC_AI_API_URL=http://localhost:3000/api/ai
