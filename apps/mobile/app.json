{
  "expo": {
    "name": "Talli",
    "slug": "settleup",
    "description": "Split group expenses, simplify balances, and settle debts without awkward math.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": ["talli", "tabkind", "settleup"],
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f8fafc"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.manoloenriquez.talli",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "L8Y7B5Z7EQ",
      "buildNumber": "3",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#059669"
      },
      "package": "com.settleup.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#f8fafc"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Talli reads the receipt photo you pick so it can fill in the expense on this iPhone. Photos are never uploaded for scanning.",
          "cameraPermission": "Talli uses the camera to photograph receipts. The photo is read on this iPhone and never uploaded for scanning.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#059669"
        }
      ],
      "@sentry/react-native",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "27.0"
          }
        }
      ],
      "./plugins/with-pod-deployment-target.js",
      "./plugins/with-ios-scene-lifecycle.js",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
