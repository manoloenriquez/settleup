# Supabase — public (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Internal API service (apps/api). Server-side only.
API_URL=http://localhost:4000

# AI / LLM — OpenAI (server-side only)
LLM_ENABLED=true
OPENAI_API_KEY=sk-...

# Error reporting — Sentry. Leave unset for no-op (no requests sent, no init cost).
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx        # server-side
# SENTRY_ENV=production
# Optional: source map upload during `next build` (requires auth token + org/project)
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# OPENAI_MODEL=gpt-4o-mini            # Text tasks (default: gpt-4o-mini)
# OPENAI_VISION_MODEL=gpt-5.4-mini    # Vision/image tasks (default: gpt-5.4-mini)

# Public launch identities: configure only after domain/mailbox verification.
NEXT_PUBLIC_SUPPORT_EMAIL=
IOS_TEAM_ID=
IOS_BUNDLE_IDENTIFIER=
ANDROID_PACKAGE=
# Comma-separated SHA-256 fingerprints from Play App Signing (colon-separated hex).
ANDROID_SHA256_CERT_FINGERPRINTS=
